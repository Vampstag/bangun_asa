---
import { SITE, whatsappUrl, langOf } from '../data/site';
import { t } from '../i18n';

const lang = langOf(Astro.url.pathname);
const d = t(lang);
const ui = d.ui;
---

<aside aria-label={ui.quickContact}>
  <!-- Tombol melayang: membuka pilihan CS. Satu ketukan lagi langsung masuk ke WhatsApp CS yang dipilih. -->
  <button
    class="wa"
    type="button"
    aria-label={ui.chatWhatsAppAria}
    aria-expanded="false"
    aria-controls="wa-pop"
    data-wa-float
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path>
    </svg>
    <span>{ui.chatWhatsApp}</span>
  </button>

  <div class="wa-pop" id="wa-pop" role="group" aria-label={ui.chatWhatsApp} inert data-wa-pop>
    {SITE.contact.phones.map((p) => (
      <a
        class="wa-pop__item"
        href={whatsappUrl(lang, undefined, p.tel)}
        target="_blank"
        rel="noopener"
        aria-label={`${d.menu.chatWith} ${p.name}`}
      >
        <span class="wa-pop__av" aria-hidden="true">
          {p.name.replace(/^CS\s+/, '').charAt(0)}
        </span>
        <span class="wa-pop__who">
          <b>{p.name}</b>
          <small>{p.display}</small>
        </span>
        <span class="wa-pop__go" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path
              d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
      </a>
    ))}
  </div>
</aside>

<script>
  // Dipasang ulang setiap halaman dimuat (termasuk setelah transisi halaman Astro).
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLElement>('[data-wa-float]');
    const pop = document.querySelector<HTMLElement>('[data-wa-pop]');
    if (!btn || !pop) return;
    const ac = new AbortController();
    const opt = { signal: ac.signal };

    const set = (open: boolean, refocus = false) => {
      pop.classList.toggle('is-open', open);
      pop.toggleAttribute('inert', !open);
      btn.setAttribute('aria-expanded', String(open));
      if (!open && refocus) btn.focus();
    };
    const sync = () => {
      const on = scrollY > 500;
      btn.classList.toggle('is-on', on);
      if (!on) set(false); // tombol menghilang, pilihan ikut tertutup
    };

    addEventListener('scroll', sync, { passive: true, ...opt });
    btn.addEventListener('click', () => set(!pop.classList.contains('is-open')), opt);
    // Klik di luar (termasuk tombol hamburger) atau memilih salah satu CS menutup pilihan.
    document.addEventListener(
      'click',
      (e) => {
        const t = e.target as Element;
        if (t.closest('[data-wa-pop] a') || !t.closest('[data-wa-pop], [data-wa-float]')) set(false);
      },
      opt,
    );
    addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && pop.classList.contains('is-open')) set(false, true);
      },
      opt,
    );
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    sync();
  });
</script>
