---
import { Image } from 'astro:assets';
import { SITE, href, isCurrent, langOf, whatsappUrl } from '../data/site';
import { t } from '../i18n';
import logo from '../assets/brand/logo.png';
import logoLight from '../assets/brand/logo-light.png';
import LangSwitch from './LangSwitch.astro';

interface Props {
  /** "dark" jika section pertama halaman gelap (mis. hero foto/video). */
  theme?: 'dark' | 'light';
}

const { theme = 'light' } = Astro.props;
const here = Astro.url.pathname;
const lang = langOf(here);
const d = t(lang);
const menu = [...d.nav, { label: d.ui.menuContact, href: d.navCta.href }];
---

<header class:list={['hdr', { 'on-dark': theme === 'dark' }]} data-hdr>
  <a class="logo" href={href('/', here)} aria-label={`${SITE.brand} — ${d.ui.home}`}>
    <!-- Dua varian logo; CSS memilih salah satunya sesuai latar (terang/gelap). -->
    <Image class="logo__img logo__img--dark" src={logo} alt="" height={68} loading="eager" />
    <Image class="logo__img logo__img--light" src={logoLight} alt="" height={68} loading="eager" />
  </a>

  <!-- Tiga kolom: logo di kiri, tautan tepat di tengah, bahasa + tombol konsultasi di kanan (simetris). -->
  <nav class="hdr__nav" aria-label={d.ui.mainNav}>
    {d.nav.map((n) => (
      <a href={href(n.href, here)} aria-current={isCurrent(n.href, here) ? 'page' : undefined}>
        {n.label}
      </a>
    ))}
  </nav>

  <div class="hdr__end">
    <LangSwitch class="lang--nav" />
    <a class="hdr__cta" href={href(d.navCta.href, here)}>
      {d.navCta.label}
    </a>
    <LangSwitch class="lang--m" />
    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label={d.ui.menuOpen}
      data-label-open={d.ui.menuOpen}
      data-label-close={d.ui.menuClose}
      data-burger
    >
      <i></i>
      <i></i>
    </button>
  </div>

  <!-- Progress baca halaman: lebarnya mengikuti posisi scroll (diatur motion.ts). -->
  <i class="hdr__progress" aria-hidden="true"></i>
</header>

<div class="menu" id="menu" inert data-menu data-lenis-prevent>
  <div class="menu__in">
    <nav class="menu__nav" aria-label={d.menu.nav}>
      <ul>
        {menu.map((n, i) => (
          <li style={`--i:${i}`}>
            <a href={href(n.href, here)} data-menu-link>
              <span class="menu__no" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="menu__txt">
                <span class="menu__txt-in">{n.label}</span>
              </span>
              <i class="menu__arr" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="menu__contact">
      <ul class="menu__cs">
        {SITE.contact.phones.map((p, i) => (
          <li class="cs" style={`--i:${i}`}>
            <span class="cs__av" aria-hidden="true">
              {p.name.replace(/^CS\s+/, '').charAt(0)}
            </span>
            <span class="cs__who">
              <b>{p.name}</b>
              <small>{p.display}</small>
            </span>
            <a
              class="cs__btn"
              href={whatsappUrl(lang, undefined, p.tel)}
              target="_blank"
              rel="noopener"
              aria-label={`${d.menu.chatWith} ${p.name}`}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </a>
            <a class="cs__btn" href={`tel:${p.tel}`} aria-label={`${d.menu.callTo} ${p.name}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M6.6 3.5h2.5l1.3 3.4-1.7 1.2a11 11 0 0 0 5.2 5.2l1.2-1.7 3.4 1.3v2.5a1.8 1.8 0 0 1-2 1.8A14.5 14.5 0 0 1 4.8 5.5a1.8 1.8 0 0 1 1.8-2z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <!-- Ikon saja agar ringkas: peta, lalu sosial media. Nama tetap ada untuk pembaca layar. -->
      <div class="menu__foot" style="--i:2">
        <a
          class="menu__icon"
          href={SITE.contact.map.openUrl}
          target="_blank"
          rel="noopener"
          aria-label={d.menu.directions}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 21s6-5.6 6-10a6 6 0 1 0-12 0c0 4.4 6 10 6 10z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            ></path>
            <circle cx="12" cy="11" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          </svg>
        </a>
        {SITE.social.map((s) => (
          <a class="menu__icon" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            {s.label === 'Instagram' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="4"
                  y="4"
                  width="16"
                  height="16"
                  rx="4.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                ></rect>
                <circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                <circle cx="16.8" cy="7.2" r="1" fill="currentColor"></circle>
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M14 4v10.2a3.4 3.4 0 1 1-3.4-3.4M14 4c.3 2.5 1.9 4.2 4.5 4.4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
