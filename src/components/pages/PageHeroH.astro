---
/**
 * Hero halaman dalam bergaya Heritage: label pil berwarna, judul besar di kiri atas, pengantar di kiri bawah,
 * foto di kanan yang memudar ke latar terang. Foto memakai foto proyek asli.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lines from '../Lines.astro';
import HBtn from './HBtn.astro';

interface Props {
  /** Pakai "|" untuk baris baru. */
  title: string;
  lead: string;
  image: ImageMetadata;
  alt?: string;
  /** Tombol opsional di bawah pengantar. */
  action?: { label: string; href: string };
}

const { title, lead, image, alt = '', action } = Astro.props;
---

<section class="hh">
  <div class="hh__media" aria-hidden={alt ? undefined : 'true'}>
    <Image src={image} alt={alt} widths={[900, 1400, 2000]} sizes="62vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="wrap hh__in">
    <div>
      <h1 class="hh__title" data-reveal>
        <Lines text={title} />
      </h1>
    </div>
    <div class="hh__bottom">
      <p class="hh__lead" data-reveal>
        {lead}
      </p>
      {action && (
        <div data-reveal>
          <HBtn href={action.href} label={action.label} />
        </div>
      )}
    </div>
  </div>
</section>
