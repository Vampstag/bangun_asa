---
/** Ajakan penutup bergaya Heritage: foto penuh dengan lapisan gelap, judul di tengah, dua tombol kotak. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getHome } from '../../data/home';
import { langOf, whatsappUrl } from '../../data/site';
import HBtn from './HBtn.astro';

interface Props {
  image: ImageMetadata;
}

const { image } = Astro.props;
const lang = langOf(Astro.url.pathname);
const { BAND } = getHome(lang);
---

<section class="cph" aria-label={BAND.title}>
  <Image class="cph__bg" src={image} alt="" widths={[900, 1600, 2400]} sizes="100vw" loading="lazy" />
  <div class="cph__veil" aria-hidden="true"></div>
  <div class="wrap cph__in">
    <h2 class="cph__title" data-reveal>
      {BAND.title}
    </h2>
    <p class="cph__text" data-reveal>
      {BAND.text}
    </p>
    <div class="cph__act" data-reveal>
      <HBtn href="#kontak" label={BAND.primary.label} variant="light" />
      <HBtn href={whatsappUrl(lang)} label={BAND.secondary} variant="ghost" target="_blank" rel="noopener" />
    </div>
  </div>
</section>
