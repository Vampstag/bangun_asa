---
import { Image } from 'astro:assets';

/**
 * Marquee logo dua baris. Gerak diatur di src/scripts/motion.ts:
 * kecepatan ikut scroll, berbalik arah saat scroll ke atas, melambat saat di-hover.
 * Tanpa JS atau saat reduced-motion, tiap baris bisa digeser manual.
 */
interface Props {
  clients: { name: string; logo?: ImageMetadata }[];
}

const { clients } = Astro.props;
const half = Math.ceil(clients.length / 2);
const rows = [
  { items: clients.slice(0, half), dir: 'left', speed: 46 },
  { items: clients.slice(half), dir: 'right', speed: 38 },
];
const COPIES = 4; // cukup untuk layar lebar; satu salinan = satu putaran loop

// Placeholder ikon geometris per logo (hanya dipakai bila `logo` kosong).
const shapes = [
  '<circle cx="12" cy="12" r="9" fill="currentColor"/>',
  '<rect x="3" y="3" width="18" height="18" fill="currentColor"/>',
  '<path d="M12 3 22 21H2z" fill="currentColor"/>',
  '<path d="M12 2 22 12 12 22 2 12z" fill="currentColor"/>',
  '<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="3.5"/>',
  '<path d="M4 4h4v16H4zM10 9h4v11h-4zM16 14h4v6h-4z" fill="currentColor"/>',
  '<path d="M12 2 21 7v10l-9 5-9-5V7z" fill="currentColor"/>',
  '<path d="M3 20A17 17 0 0 1 20 3v17z" fill="currentColor"/>',
];
---

<div class="cmq">
  <div class="cmq__rows">
    {rows.map((row, r) => (
      <div class="cmq__row" data-cmq data-dir={row.dir} data-speed={row.speed} data-per={row.items.length}>
        <ul class="cmq__track">
          {Array.from({ length: COPIES }).flatMap((_, copy) =>
            row.items.map((c, i) => (
              <li class="cmq__item" aria-hidden={copy > 0 ? 'true' : undefined}>
                {c.logo ? (
                  <Image src={c.logo} alt={copy === 0 ? c.name : ''} height={48} loading="lazy" />
                ) : (
                  <>
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={shapes[(i + r * half) % shapes.length]} />
                    <span>{c.name}</span>
                  </>
                )}
              </li>
            )),
          )}
        </ul>
      </div>
    ))}
  </div>
</div>
