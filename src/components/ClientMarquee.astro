---
import { Image } from 'astro:assets';
import Icon from './pages/Icon.astro';
import type { IconName } from '../data/icons';

/**
 * Marquee logo dua baris. Gerak diatur di src/scripts/motion.ts:
 * kecepatan ikut scroll, berbalik arah saat scroll ke atas, melambat saat di-hover.
 * Tanpa JS atau saat reduced-motion, tiap baris bisa digeser manual.
 */
interface Props {
  clients: { name: string; icon?: IconName; logo?: ImageMetadata }[];
}

const { clients } = Astro.props;
const half = Math.ceil(clients.length / 2);
const rows = [
  { items: clients.slice(0, half), dir: 'left', speed: 46 },
  { items: clients.slice(half), dir: 'right', speed: 38 },
];
const COPIES = 4; // cukup untuk layar lebar; satu salinan = satu putaran loop
---

<div class="cmq">
  <div class="cmq__rows">
    {rows.map((row) => (
      <div class="cmq__row" data-cmq data-dir={row.dir} data-speed={row.speed} data-per={row.items.length}>
        <ul class="cmq__track">
          {Array.from({ length: COPIES }).flatMap((_, copy) =>
            row.items.map((c) => (
              <li class="cmq__item" aria-hidden={copy > 0 ? 'true' : undefined}>
                {c.logo ? (
                  <Image src={c.logo} alt={copy === 0 ? c.name : ''} height={48} loading="lazy" />
                ) : (
                  <>
                    {c.icon && <Icon name={c.icon} />}
                    <span>{c.name}</span>
                  </>
                )}
              </li>
            )),
          )}
        </ul>
      </div>
    ))}
  </div>
</div>
