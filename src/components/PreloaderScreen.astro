---
/** Tampilan layar pembuka (tanpa logika). Dipakai Preloader.astro untuk muat pertama dan untuk pindah halaman. */
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import { langOf } from '../data/site';
import { t } from '../i18n';

interface Props {
  id?: string;
  class?: string;
}
const { id, class: extra } = Astro.props;

const lines = t(langOf(Astro.url.pathname)).home.hero.tag.split(' · ');
const words = ['Bangun', 'Asa'];
// nomor urut huruf menerus dari kata pertama ke kata kedua, untuk jeda bergelombang
const letters = words.map((word, w) =>
  [...word].map((char, c) => ({ char, i: words.slice(0, w).join('').length + c })),
);
---

<div class:list={['pre', extra]} id={id} aria-hidden="true" data-lenis-prevent>
  <!-- tiga lapisan: merah, putih, gelap. Saat masuk dan keluar, tepi merah dan putihnya menyapu layar. -->
  <i class="pre__sheet pre__sheet--red"></i>
  <i class="pre__sheet pre__sheet--white"></i>
  <div class="pre__sheet pre__sheet--dark">
    <i class="pre__line"></i>
    <div class="pre__foot">
      <span class="pre__mark">
        {/* dua salinan simbol: sisi kiri dan kanan atap naik bergantian */}
        <Image src={mark} alt="" width={320} loading="eager" />
        <Image src={mark} alt="" width={320} loading="eager" />
      </span>
      <p class="pre__word">
        {letters.map((word) => (
          <span class="pre__w">
            {word.map(({ char, i }) => (
              <span class="pre__ch" style={`--i:${i}`}>
                <span class="pre__a">{char}</span>
                <span class="pre__b">{char}</span>
              </span>
            ))}
          </span>
        ))}
      </p>
      <p class="pre__desc">
        <span>({lines[0]}</span>
        <span>{lines[1]})</span>
      </p>
      <i class="pre__spin"></i>
    </div>
  </div>
</div>
