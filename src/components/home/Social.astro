---
/**
 * Section "Media sosial" (di bagian bawah, sebelum kontak): kartu profil TikTok + video terbaru. Data diperbarui otomatis oleh
 * .github/workflows/sync-tiktok.yml (tools/sync-tiktok.cjs) setiap ada video baru.
 * Video tidak dimuat sampai diklik: yang tampil hanya thumbnail milik kita, jadi halaman tetap ringan dan tidak ada
 * skrip TikTok yang berjalan sebelum pengunjung memilih memutar. Tanpa JavaScript, kartu membuka video di TikTok.
 */
import { Image } from 'astro:assets';
import { getSocial } from '../../data/social';
import { langOf } from '../../data/site';
import { t } from '../../i18n';
import SectionHead from '../SectionHead.astro';

const lang = langOf(Astro.url.pathname);
const S = t(lang).home.social;
const social = getSocial(lang, 4);
const mark = `${import.meta.env.BASE_URL}favicon.png`;
---

{social.hasVideos && (
  <section class="sec soc" id="sosial" aria-label={S.label}>
    <div class="wrap">
      <SectionHead label={S.label} title={S.title} />

      <!-- Kepala minimalis: identitas akun di kiri, dua tautan sosial yang setara di kanan. -->
      <div class="soc__profile" data-reveal>
        <div class="soc__id">
          <span class="soc__av">
            <img src={mark} alt="" width="32" height="32" loading="lazy" />
          </span>
          <div>
            <p class="soc__name">{social.profile.name}</p>
            <p class="soc__handle">
              <span>@{social.profile.handle}</span>
              <span>
                {social.profile.followers} {S.followers}
              </span>
            </p>
          </div>
        </div>
        <ul class="soc__links">
          <li>
            <a class="soc__btn" href={social.profile.url} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 4v10.2a3.4 3.4 0 1 1-3.4-3.4M14 4c.3 2.5 1.9 4.2 4.5 4.4" />
              </svg>
              TikTok
            </a>
          </li>
          {social.profile.instagram && (
            <li>
              <a class="soc__btn" href={social.profile.instagram} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="4" y="4" width="16" height="16" rx="4.5" />
                  <circle cx="12" cy="12" r="3.6" />
                  <circle class="soc__dot" cx="16.8" cy="7.2" r="1" />
                </svg>
                Instagram
              </a>
            </li>
          )}
        </ul>
      </div>

      <ul class="soc__grid">
        {social.videos.map((v, i) => (
          <li>
            <a
              class="vid"
              href={v.url}
              target="_blank"
              rel="noopener"
              data-vid={v.id}
              data-title={`${S.play} ${i + 1}`}
              aria-label={`${S.play} ${i + 1}`}
              data-reveal
            >
              <Image
                src={v.image}
                alt=""
                widths={[320, 480, 720]}
                sizes="(min-width: 901px) 24vw, 46vw"
                loading="lazy"
              />
              <span class="vid__play" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<script>
  // Klik kartu memutar video di tempat (player resmi TikTok, baru dimuat saat diklik). Hanya satu video aktif sekali waktu.
  let active: { el: HTMLElement; html: string } | null = null;

  const stop = () => {
    if (!active) return;
    active.el.innerHTML = active.html;
    active.el.classList.remove('is-playing');
    active = null;
  };

  document.addEventListener('click', (e) => {
    const card = (e.target as Element).closest<HTMLElement>('.vid[data-vid]');
    if (!card || card.classList.contains('is-playing')) return;
    // Ctrl/Cmd/klik tengah tetap membuka TikTok di tab baru.
    if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).button === 1) return;
    e.preventDefault();
    stop();
    active = { el: card, html: card.innerHTML };
    const frame = document.createElement('iframe');
    frame.src = `https://www.tiktok.com/player/v1/${card.dataset.vid}?autoplay=1&music_info=1&description=0`;
    frame.title = card.dataset.title ?? 'TikTok';
    frame.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
    frame.allowFullscreen = true;
    frame.setAttribute('loading', 'lazy');
    card.classList.add('is-playing');
    card.replaceChildren(frame);
  });

  // Berpindah halaman (transisi Astro): video yang sedang jalan dihentikan.
  document.addEventListener('astro:before-swap', stop);
</script>
