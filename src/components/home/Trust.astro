---
import { getHome } from '../../data/home';
import { langOf } from '../../data/site';
import ClientMarquee from '../ClientMarquee.astro';

const lang = langOf(Astro.url.pathname);
const { TRUST, STATS } = getHome(lang);
---

<!--
  Strip bukti singkat tepat di bawah hero: jenis bangunan yang dikerjakan + angka. Dokumen legal dan sertifikat
  ada di halaman Tentang (Legal.astro): rinci soal perusahaan tidak untuk beranda.
-->
<section class="trust" aria-label={TRUST.aria}>
  <div class="wrap">
    <div class="split trust__head">
      <p class="label" data-reveal>
        {TRUST.clientsLabel}
      </p>
      <p class="trust__lead" data-reveal>
        {TRUST.clientsLead}
      </p>
    </div>
  </div>

  <div data-reveal>
    <ClientMarquee clients={TRUST.items} />
  </div>

  <div class="wrap">
    <dl class="stats" style={`--n:${STATS.length}`}>
      {STATS.map((s) => (
        <div data-reveal>
          <dt>
            {s.plain ? <span>{s.value}</span> : <span data-count={s.value}>{s.value}</span>}
            <sup>{s.suffix}</sup>
          </dt>
          <dd>{s.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
