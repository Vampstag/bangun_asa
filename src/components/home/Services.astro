---
import { Image } from 'astro:assets';
import { getHome } from '../../data/home';
import { href, langOf } from '../../data/site';

const { SERVICES } = getHome(langOf(Astro.url.pathname));

const here = Astro.url.pathname;
const pad = (i: number) => String(i + 1).padStart(2, '0');
// urutan sama dengan daftar layanan (dan dengan halaman Layanan)
const models = ['new', 'renovation', 'total', 'commercial'];
---

<section class="svcs" id="layanan" data-svc3d>
  <!-- Desktop: panggung menempel, scroll menggeser tab aktif. Mobile: daftar terbuka biasa. -->
  <div class="tabs" data-tabs style={`--n:${SERVICES.items.length}`}>
    <div class="tabs__stage">
      <div class="wrap tabs__grid">
        <!-- Judul ada di dalam panggung sticky, satu kolom dengan keempat layanannya. -->
        <header class="tabs__head">
          <p class="label" data-reveal>
            {SERVICES.label}
          </p>
          <h2 class="h2" data-reveal>
            {SERVICES.title}
          </h2>
        </header>
        <!--
          Pola akordeon (daftar + tombol + aria-expanded), bukan role="tab":
          pada mobile semua isi terbuka, pada desktop scroll yang membuka satu per satu.
          Tombol baru bisa difokus saat mode sticky aktif (diatur motion.ts).
        -->
        <ul class="tabs__list">
          {SERVICES.items.map((s, i) => (
            <li class:list={['tab', { 'is-active': i === 0 }]} data-tab>
              <h3 class="tab__h">
                <button class="tab__btn" type="button" tabindex="-1" aria-controls={`svc-panel-${i}`} data-tab-btn>
                  <span class="tab__no">{pad(i)}</span>
                  <span class="tab__title">{s.title}</span>
                </button>
              </h3>
              <div class="tab__body" id={`svc-panel-${i}`}>
                <div class="tab__in">
                  <p>{s.text}</p>
                  <a class="arrow-link" href={href(SERVICES.href, here)}>
                    {SERVICES.cta} <i aria-hidden="true"></i>
                  </a>
                  <figure class="media tab__m">
                    <Image src={s.image} alt="" widths={[600, 900]} sizes="100vw" loading="lazy" data-fit={s.fit} />
                  </figure>
                </div>
              </div>
              <span class="tab__bar" aria-hidden="true">
                <i></i>
              </span>
            </li>
          ))}
        </ul>

        {/* Model 3D layanan yang aktif: satu kanvas untuk keempatnya. Di HP dan tablet kanvas ini dipindahkan ke dalam
            akordeon yang sedang terbuka (src/scripts/models/switcher.ts). Foto di bawahnya hanya cadangan tanpa WebGL. */}
        <div class="tabs__visual" aria-hidden="true">
          <div class="svc3d m3d" data-svc3d-host data-kinds={models.join(',')}>
            <canvas />
          </div>
          <figure class="media">
            {SERVICES.items.map((s, i) => (
              <Image
                src={s.image}
                alt=""
                widths={[600, 900, 1200]}
                sizes="(min-width: 1440px) 460px, 36vw"
                loading="lazy"
                class:list={{ 'is-active': i === 0 }}
                data-tab-img
                data-fit={s.fit}
              />
            ))}
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/models/switcher';
</script>
