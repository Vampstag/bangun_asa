---
import fs from 'node:fs';
import { Image } from 'astro:assets';
import { getHome } from '../../data/home';
import { href, langOf, whatsappUrl } from '../../data/site';
import Lines from '../Lines.astro';
import HBtn from '../pages/HBtn.astro';

const { HERO } = getHome(langOf(Astro.url.pathname));

const here = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Video hanya dirender bila file-nya benar-benar ada di public/, jadi tidak ada 404 atau markup mati.
// Dua versi: HD (1080p) untuk layar lebar, SD (720p) untuk HP dan koneksi lambat. Skrip di bawah memilih salah satunya.
const exists = (p: string) => fs.existsSync(new URL(`../../../public/${p}`, import.meta.url));
const hd = exists(HERO.video.hd) ? `${base}${HERO.video.hd}` : undefined;
const sd = exists(HERO.video.sd) ? `${base}${HERO.video.sd}` : undefined;
const hasVideo = Boolean(hd || sd);
---

<section class="hero" data-theme="dark">
  <div class="hero__media">
    <!-- Foto: cadangan, dan tampil sampai video siap diputar. -->
    <Image
      src={HERO.image}
      alt={HERO.alt}
      loading="eager"
      fetchpriority="high"
      widths={[900, 1600, 2400]}
      sizes="100vw"
    />
    {hasVideo && (
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        disablepictureinpicture
        disableRemotePlayback
        data-hd={hd}
        data-sd={sd}
      />
    )}
  </div>
  <!-- Menggelap pelan-pelan saat section berikutnya naik menutupi hero (diatur motion.ts). -->
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <div class="hero__text">
      <h1 class="hero__title">
        <Lines text={HERO.title} mask />
      </h1>
    </div>
    <div class="hero__aside" data-hero>
      <p>{HERO.lead}</p>
      <div class="hero__d">
        <HBtn href={href(HERO.cta.href, here)} label={HERO.cta.label} variant="light" />
      </div>
      <!-- HP: satu ketukan langsung ke WhatsApp; tautan kedua untuk yang ingin lihat bukti dulu -->
      <div class="hero__m">
        <HBtn href={whatsappUrl(langOf(here))} label={HERO.waCta} target="_blank" rel="noopener" />
        <a class="hero__link" href="#karya">
          {HERO.workLink} <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <!-- bidang usaha dan lokasi: baris tipis penutup hero, rata kiri dan kanan -->
    <p class="hero__meta" data-hero>
      {HERO.tag.split(' · ').map((part) => (
        <span>{part}</span>
      ))}
    </p>
  </div>
</section>

<script>
  // Dipasang ulang setiap halaman dimuat (termasuk setelah transisi halaman Astro).
  document.addEventListener('astro:page-load', () => {
    const video = document.querySelector<HTMLVideoElement>('.hero__video');
    if (!video) return;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const skip = matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData;
    if (skip) {
      video.remove(); // tetap foto
      return;
    }
    // Pilih versi: HD hanya untuk layar lebar dengan koneksi yang cukup; selain itu SD (lebih kecil, cukup tajam di layar kecil).
    const slow = /(^|-)(2g|3g)$/.test(conn?.effectiveType ?? '');
    const wide = matchMedia('(min-width: 1000px)').matches;
    const src = wide && !slow ? video.dataset.hd || video.dataset.sd : video.dataset.sd || video.dataset.hd;
    if (!src) {
      video.remove();
      return;
    }
    if (!video.getAttribute('src')) video.src = src;
    // Fade video in only once frames are really playing; until then the photo is visible.
    const reveal = () => video.classList.add('is-playing');
    if (!video.paused && video.currentTime > 0) reveal();
    else video.addEventListener('playing', reveal, { once: true });
    video.play().catch(() => {});
    // Hemat baterai: jeda saat hero di luar layar.
    // Hero tetap "terlihat" bagi browser saat tertutup section di atasnya, jadi cek juga posisi tirai itu.
    const covered = () => (document.querySelector('[data-curtain]')?.getBoundingClientRect().top ?? 1) <= 0;
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !covered()) video.play().catch(() => {});
      else video.pause();
    });
    io.observe(video);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
