---
/**
 * "Cara kami bekerja": judul menempel di kiri (sticky) sementara tujuh langkah bergulir di kanan. Tiap langkah muncul satu per satu
 * saat di-scroll, dan langkah yang sedang dibaca menyala (ikon terisi, judul tegas) lewat motion.ts. Di layar sempit berupa daftar biasa.
 * Dipakai di beranda dan halaman Layanan.
 */
import { getHome } from '../../data/home';
import { langOf } from '../../data/site';
import { t } from '../../i18n';
import { ICONS } from '../../data/icons';
import Model3D from './Model3D.astro';

const lang = langOf(Astro.url.pathname);
const { PROCESS } = getHome(lang);
const stepLabel = t(lang).ui.step;

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="sec proc" id="proses">
  <div class="wrap proc__grid" data-proc>
    <div class="proc__side">
      <p class="label" data-reveal>
        {PROCESS.label}
      </p>
      <h2 class="h2" data-reveal style="margin-top: clamp(24px, 3vw, 40px)">
        {PROCESS.title}
      </h2>
      <p class="proc__lead" data-reveal>
        {PROCESS.lead}
      </p>
      <div class="proc__model">
        <div class="proc__count" aria-hidden="true">
          <b data-proc-cur>01</b>
          <span>/ {pad(PROCESS.steps.length - 1)}</span>
        </div>
        <Model3D kind="process" caption={false} />
      </div>
    </div>

    <ol class="steps proc__steps">
      {PROCESS.steps.map((s, i) => (
        <li data-step data-reveal class:list={{ 'is-active': i === 0 }}>
          <div class="step__top">
            <span class="step__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={ICONS[s.icon]} />
            </span>
            <span class="step__no">
              {stepLabel} {pad(i)}
            </span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
