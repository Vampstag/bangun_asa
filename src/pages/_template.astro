---
/**
 * STARTER HALAMAN BARU
 * Salin file ini jadi src/pages/nama-halaman.astro (jadi /nama-halaman/),
 * ganti title/label/lead, lalu isi section. Awalan "_" membuat file ini tidak jadi halaman.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cta from '../components/Cta.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
---

<Layout title="Judul Halaman" description="Deskripsi singkat halaman ini.">
  <Header />
  <main id="top">
    <PageHero
      label="Nama halaman"
      title="Judul besar halaman|bisa dua baris."
      lead="Satu atau dua kalimat pengantar."
    />

    <section class="sec">
      <div class="wrap">
        <SectionHead label="Label section" title="Judul section." />
        <p class="manifesto">Konten halaman ditulis di sini.</p>
      </div>
    </section>

    <Cta />
  </main>
  <Footer />
</Layout>
