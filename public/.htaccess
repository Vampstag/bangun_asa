# Aturan server untuk cPanel (Apache). Ikut terunggah ke public_html bersama situs.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # (Opsional) paksa HTTPS: buka komentar dua baris di bawah SETELAH SSL aktif di cPanel.
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Alamat halaman lama (situs PHP sebelumnya) dialihkan ke bagian yang setara di situs baru, supaya
  # tautan lama dan hasil Google tidak jadi halaman kosong.
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^(tentang-kami|about)\.php$ /about [R=301,L]
  RewriteRule ^(terms|privacy)\.php$ / [R=301,L]
  RewriteRule ^(portfolio|gallery)\.php$ /#karya [R=301,NE,L]
  RewriteRule ^services\.php$ /#layanan [R=301,NE,L]
  RewriteRule ^testimonial\.php$ /#testimoni [R=301,NE,L]
  RewriteRule ^contact\.php$ /#kontak [R=301,NE,L]

  # File hasil build di /_astro/ bernama unik (hash), jadi aman disimpan lama di browser.
  RewriteRule ^_astro/ - [E=IMMUTABLE_ASSET:1]
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
  # Halaman HTML selalu dicek ulang supaya konten baru langsung muncul setelah deploy.
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
