{
  "name": "bangun-asa-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node tools/sync-cms.cjs",
    "build": "astro build",
    "prebuild": "node tools/sync-cms.cjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{astro,ts,mjs}\" astro.config.mjs eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{astro,ts,mjs}\" astro.config.mjs eslint.config.js",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build",
    "cms:sync": "node tools/sync-cms.cjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@sveltia/cms": "^0.271.3",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
